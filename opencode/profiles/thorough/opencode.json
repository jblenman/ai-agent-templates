{
  "$schema": "https://opencode.ai/config.json",
  "model": "azure/gpt-6.1-sol",
  "small_model": "azure/gpt-5.6-luna",
  "share": "disabled",
  "autoupdate": false,
  "disabled_providers": [
    "opencode"
  ],
  "provider": {
    "azure": {
      "npm": "@ai-sdk/azure",
      "name": "Azure GPT",
      "env": [
        "AZURE_OPENAI_API_KEY"
      ],
      "options": {
        "resourceName": "YOUR_RESOURCE_NAME",
        "apiKey": "{env:AZURE_OPENAI_API_KEY}"
      },
      "whitelist": [
        "gpt-6.1-sol",
        "gpt-5.6-sol",
        "gpt-5.6-luna",
        "gpt-6-luna",
        "gpt-5.5"
      ],
      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low"
          }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (efficient tier)",
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low"
          }
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna (efficient tier)",
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low"
          }
        },
        "gpt-5.5": {
          "name": "GPT-5.5 (retiring)",
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low"
          }
        }
      }
    }
  },
  "skills": {
    "paths": [
      "~/ai-agent-templates/skills"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "preserve_recent_tokens": 10000
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "skill": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "ask",
    "edit": "allow",
    "write": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "dotnet *": "allow",
      "python *": "allow",
      "node *": "allow",
      "bun *": "allow",
      "ls *": "allow",
      "dir *": "allow",
      "cat *": "allow",
      "type *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "copy *": "allow",
      "mv *": "allow",
      "move *": "allow",
      "rm *": "ask",
      "del *": "ask",
      "curl *dev.azure.com*": "allow",
      "powershell*Invoke-RestMethod*dev.azure.com*": "allow",
      "pwsh*Invoke-RestMethod*dev.azure.com*": "allow"
    }
  },
  "instructions": [
    "AGENTS.md",
    "CONTRIBUTING.md"
  ]
}
